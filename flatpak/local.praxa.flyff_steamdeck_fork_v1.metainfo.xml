<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>local.praxa.flyff_steamdeck_fork_v1</id>
  <name>Flyff Steamdeck Fork v1</name>
  <summary>Flyff Universe Launcher mit Steam-Deck-Controller-Layout</summary>
  <description>
    <p>
      Fork des Flyff-U-Launchers, optimiert fuer das Steam Deck.
      Eigener Visual-Style mit Deck-Silhouette, vier echte Back-Paddle-Bindings
      (L4/L5/R4/R5) und Deck-eigene Default-Belegung mit sieben in Reichweite
      liegenden Skill-Slots.
    </p>
    <p>
      Diese Flatpak-Build verwendet eine fork-eigene Versionierung (1, 2, 3, ...)
      unabhaengig vom Upstream-Launcher.
    </p>
  </description>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer_name>Praxa</developer_name>
  <launchable type="desktop-id">local.praxa.flyff_steamdeck_fork_v1.desktop</launchable>
  <categories>
    <category>Game</category>
    <category>RolePlaying</category>
  </categories>
  <releases>
    <release version="1" date="2026-05-12">
      <description>
        <p>Erste Flatpak-Release des Steam-Deck-Forks.</p>
        <p>Basis: Flyff-U-Launcher Upstream-Stand 3.8.0 (Steam-Deck-Controller-Layout, Back-Paddle-Bindings, Deck-Defaults).</p>
      </description>
    </release>
  </releases>
</component>
